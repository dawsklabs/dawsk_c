include {args};

pub struct MyStruct<T = i32> {
    a: i8,
    b: String,
    c: T,
};

pub const M: i16 = -15 + 5; // constants

pub struct A(i8, pkg.B);

pub type B<T> = (T, u8);

type C<T = i32> = B<T>;

struct E;

pub struct Token {
    pub kind: TokenKind,
    pub span: Span,
}

func a(mut x: i32) -> i32 {
    x + 1 // return statement
}

pub enum TokenKind {
    // Keywords
    Keyword(super.a.Keyword),

    // Types
    Type(Ty),
    Identifier(String),
    Integer(u128),
    Float(f64),
    Byte(u8),
    Char(char),
    String(String),
    ByteString(Vec<u8>),
    RawString(String),
    RawByteString(Vec<u8>),
    Bool(bool),
    Unknown(char),

    // Operators
    Plus,
    Minus,
    Asterisk,
    Slash,
    Percent,

    DoublePlus,
    DoubleMinus,

    PlusEquals,
    MinusEquals,
    AsteriskEquals,
    SlashEquals,

    Equals,
    DoubleEquals,
    ExclamationEquals,

    And,
    Pipe,
    Caret,
    DoubleAnd,
    DoublePipe,

    // Punctuation
    Dot,
    Comma,
    Colon,
    Semicolon,
    Exclamation,
    Question,
    Underscore,

    // Brackets
    LParen,
    RParen,
    LBracket,
    RBracket,
    LCurly,
    RCurly,

    LAngle,
    DoubleLAngle,
    LAngleEquals,

    RAngle,
    DoubleRAngle,
    RAngleEquals,

    // Specials
    Error,
    EndOfFile,
}

macro add {
    ($($x:expr),*) => { (0 $(+ $x)*) };
}

dec result = add!{1, 2, 3, 5, 4};

func foo<T: Display + Clone + Display + Display>(x: T) -> T
require
    T: Clone + Add + Clone,
{
    x + x.clone()
}